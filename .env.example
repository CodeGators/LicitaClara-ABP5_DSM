# Exemplos somente para desenvolvimento local; copiar para .env na raiz.
APP_ENV=local
LOG_LEVEL=INFO
# A porta 55432 evita conflito com PostgreSQL local na porta padrão.
POSTGRES_USER=licita
POSTGRES_PASSWORD=licita_local_only
POSTGRES_DB=licita_clara
POSTGRES_PORT=55432
# URL inicial de bootstrap; local-logins a substituirá pela conexão restrita da API.
DATABASE_URL=postgresql+psycopg://licita:licita_local_only@127.0.0.1:55432/licita_clara
DB_CONNECT_TIMEOUT=3
DB_STATEMENT_TIMEOUT_MS=3000
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=0
CORS_ALLOWED_ORIGINS=["http://localhost:5173"]
STORAGE_ROOT=data/objects
# Conexão exclusiva para testes que criam/removem uma tabela de teste:
TEST_DATABASE_URL=postgresql+psycopg://licita:licita_local_only@127.0.0.1:55432/licita_clara_test

# Migrações explícitas; não utilizada pela aplicação HTTP.
MIGRATION_DATABASE_URL=postgresql+psycopg://licita:licita_local_only@127.0.0.1:55432/licita_clara

# As URLs abaixo serão geradas no .env por db.permissions local-logins.
# Não copiar a credencial administrativa para serviços de coleta/processamento.
# COLLECTOR_DATABASE_URL=postgresql+psycopg://<login-coleta>:<senha>@127.0.0.1:55432/licita_clara
# PROCESSING_DATABASE_URL=postgresql+psycopg://<login-processamento>:<senha>@127.0.0.1:55432/licita_clara

# Coletor: limites de aquisição e extração (ajuste para competências maiores).
COLLECTOR_TIMEOUT=30
COLLECTOR_ATTEMPTS=3
COLLECTOR_MAX_DOWNLOAD_BYTES=104857600
COLLECTOR_MAX_UNCOMPRESSED_BYTES=2147483648
COLLECTOR_MAX_MEMBERS=32
COLLECTOR_MAX_COMPRESSION_RATIO=200
COLLECTOR_TEMP_DIR=data/tmp/collector
COLLECTOR_EXTRACT_DIR=data/extracted

# Armazenamento remoto opcional; instalar extra s3 antes de habilitar.
STORAGE_BACKEND=local
# OBJECT_STORAGE_ENDPOINT=https://<conta>.r2.cloudflarestorage.com
# OBJECT_STORAGE_BUCKET=<bucket-privado>
# OBJECT_STORAGE_ACCESS_KEY_ID=<chave>
# OBJECT_STORAGE_SECRET_ACCESS_KEY=<segredo>

# Preparação/importação: utiliza a conexão restrita PROCESSING_DATABASE_URL gerada acima.
PROCESSING_WORK_DIR=data/processing
PROCESSING_BATCH_SIZE=500
PROCESSING_MAX_FILE_BYTES=104857600
PROCESSING_MAX_UNCOMPRESSED_BYTES=2147483648
