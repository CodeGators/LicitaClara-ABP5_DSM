# Copiar para .env.neon na raiz, que fica ignorado pelo Git.
# Usar a conexão DIRECT do Neon, com PostgreSQL 17 e sslmode=require.
# O prefixo postgresql+psycopg é utilizado pela API SQLAlchemy.
DATABASE_URL=postgresql+psycopg://<usuario-api>:<senha>@<host-neon>/<banco>?sslmode=require
# A conexão administrativa serve apenas para preparar/restaurar o banco.
MIGRATION_DATABASE_URL=postgresql+psycopg://<administrador>:<senha>@<host-neon>/<banco>?sslmode=require
